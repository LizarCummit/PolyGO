# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000
FRONTEND_URL=http://localhost:3000

# Google Cloud (speech-to-text, translation, storage)
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_BUCKET_NAME=your-bucket-name
# Path to a service-account key file stored OUTSIDE this repository
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# AI provider: "openai" or "deepseek"
AI_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional, subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
